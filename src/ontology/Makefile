# WARNING: generated by OntoBoard. Do NOT edit by hand.
# Put custom targets in pizza.Makefile, which is included below.

ONT_ID := pizza
ONT := $(ONT_ID)
TODAY := $(shell date +%Y-%m-%d)
VERSION ?= $(TODAY)
VERSION_IRI ?= https://ebrahimnorouzi.github.io/pizza-ontology/pizza/releases/$(VERSION)/$(ONT).owl
CATALOG := catalog-v001.xml
ROBOT := robot --catalog $(CATALOG)

.DEFAULT_GOAL := all

-include $(ONT).Makefile

.PHONY: all test reason report sparql_test validate_profile clean prepare_release

all: reason report
	@echo "Build complete: $(ONT)"

test: reason report sparql_test validate_profile

reason:
	$(ROBOT) reason -r ELK -i $(ONT)-edit.owl \
	  --equivalent-classes-allowed asserted-only \
	  --exclude-tautologies structural \
	  -o $(ONT).owl

# profile.txt lists every ROBOT report rule at its severity. ROBOT does NOT
# merge it with its defaults - it runs exactly what is in the file, so a rule
# you delete stops running silently. To relax one, change ERROR to WARN or INFO
# rather than deleting the line. Do not put comments in profile.txt: ROBOT has
# no comment syntax there and will refuse to run.
report:
	$(ROBOT) report -i $(ONT)-edit.owl --profile profile.txt \
	  --fail-on ERROR --labels true \
	  --output report.tsv --format tsv

sparql_test:
	$(ROBOT) verify --input $(ONT)-edit.owl --queries ../sparql/*.rq --output-dir .

validate_profile:
	$(ROBOT) merge -i $(ONT)-edit.owl convert -f ofn -o tmp_validate.ofn
	$(ROBOT) validate-profile --profile DL -i tmp_validate.ofn \
	  -o validate-profile.txt || { cat validate-profile.txt; exit 1; }
	@rm -f tmp_validate.ofn

clean:
	@rm -f tmp_* report.tsv validate-profile.txt *.bak *.csv $(ONT).owl

prepare_release: test
	@mkdir -p ../../releases/$(VERSION)
	$(ROBOT) annotate --input $(ONT).owl \
	  --version-iri "$(VERSION_IRI)" \
	  --annotation owl:versionInfo "$(VERSION)" \
	  --output ../../releases/$(VERSION)/$(ONT).owl
	@cp ../../releases/$(VERSION)/$(ONT).owl ../../$(ONT).owl
