/pizza.owl
/pizza.obo
/pizza.json
/pizza.db
/pizza-base.*
/pizza-basic.*
/pizza-full.*
/pizza-simple.*
/pizza-simple-non-classified.*
/mappings/
/patterns/
/reports/
/subsets/

