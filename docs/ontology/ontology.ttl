:SpicyTopping rdf:type owl:Class ;
              rdfs:subClassOf :PizzaTopping ;
              <http://purl.obolibrary.org/obo/IAO_0000115> "A topping that makes a pizza hot."@en ;
              rdfs:label "spicy topping"@en .


