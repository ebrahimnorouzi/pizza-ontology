@prefix : <https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#> .

<https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl> rdf:type owl:Ontology ;
                                                             owl:versionIRI <https://ebrahimnorouzi.github.io/pizza-ontology/pizza/1.0.0> ;
                                                             <http://purl.org/dc/terms/description> "A pizza ontology built with OntoBoard from ontology design patterns, following the eXtreme Design methodology."@en ;
                                                             <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                                                             <http://purl.org/dc/terms/title> "Pizza Ontology"@en ;
                                                             rdfs:label "Pizza Ontology"@en ;
                                                             owl:priorVersion <https://ebrahimnorouzi.github.io/pizza-ontology/pizza/0.4.0> ;
                                                             owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.obolibrary.org/obo/IAO_0000115
<http://purl.obolibrary.org/obo/IAO_0000115> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#classifies
<http://www.ontologydesignpatterns.org/cp/owl/classification.owl#classifies> rdf:type owl:ObjectProperty ;
                                                                             rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept> ;
                                                                             rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity> ;
                                                                             rdfs:label "classifies" .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#isClassifiedBy
<http://www.ontologydesignpatterns.org/cp/owl/classification.owl#isClassifiedBy> rdf:type owl:ObjectProperty ;
                                                                                 rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity> ;
                                                                                 rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept> ;
                                                                                 rdfs:label "isClassifiedBy" .


###  http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent
<http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent> rdf:type owl:ObjectProperty ;
                                                                           rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart> ;
                                                                           owl:inverseOf <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf> ;
                                                                           rdfs:comment """The hasPart relation without transitivity, holding between an entity (the system) and another (the component), and assuming a design that structures the system. For an explicit pattern encoding design, see the 'designobject' pattern.
The componency pattern uses the transitive reduction logical pattern to preserve transitive on the superproperty from the partof pattern. In practice, the partof pattern acts here as the transitive reduction of the componency pattern.""" ;
                                                                           rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/componency.owl> ;
                                                                           rdfs:label "has component"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf
<http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf> rdf:type owl:ObjectProperty ;
                                                                            rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf> ;
                                                                            rdfs:comment """The hasPart relation without transitivity, holding between an entity (the system) and another (the component), and assuming a design that structures the system. For an explicit pattern encoding design, see the 'designobject' pattern.
The componency pattern uses the transitive reduction logical pattern to preserve transitive on the superproperty from the partof pattern. In practice, the partof pattern acts here as the transitive reduction of the componency pattern.""" ;
                                                                            rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/componency.owl> ;
                                                                            rdfs:label "is component of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart
<http://www.ontologydesignpatterns.org/cp/owl/partof.owl#hasPart> rdf:type owl:ObjectProperty ;
                                                                  owl:inverseOf <http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf> ;
                                                                  rdf:type owl:TransitiveProperty ;
                                                                  rdfs:comment "A transitive relation expressing parthood between any entities, e.g. 'the human body has a brain as part'. When specializing this pattern, take care of restricting the domain and range appropriately, since it could be counterintuitive to use this relation arbitrarily, e.g. between animals and planets. For an intransitive partof pattern, see 'componency'." ;
                                                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/partof.owl> ;
                                                                  rdfs:label "has part"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf
<http://www.ontologydesignpatterns.org/cp/owl/partof.owl#isPartOf> rdf:type owl:ObjectProperty ,
                                                                            owl:TransitiveProperty ;
                                                                   rdfs:comment "A transitive relation expressing parthood between any entities, e.g. 'brain is a part of the human body'. When specializing this pattern, take care of restricting the domain and range appropriately, since it could be counterintuitive to use this relation arbitrarily, e.g. between animals and planets. For an intransitive partof pattern, see 'componency'." ;
                                                                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/partof.owl> ;
                                                                   rdfs:label "is part of"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasCurrency
<http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasCurrency> rdf:type owl:ObjectProperty ;
                                                                     rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price> ;
                                                                     rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/price.owl#Currency> ;
                                                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/price.owl> ;
                                                                     rdfs:label "has currency"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasPrice
<http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasPrice> rdf:type owl:ObjectProperty ;
                                                                  owl:inverseOf <http://www.ontologydesignpatterns.org/cp/owl/price.owl#isPriceOf> ;
                                                                  rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price> ;
                                                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/price.owl> ;
                                                                  rdfs:label "has price"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/price.owl#isPriceOf
<http://www.ontologydesignpatterns.org/cp/owl/price.owl#isPriceOf> rdf:type owl:ObjectProperty ;
                                                                   rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price> ;
                                                                   rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/price.owl> ;
                                                                   rdfs:label "is price of"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasBase
:hasBase rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent> ;
         rdfs:domain :Pizza ;
         rdfs:range :PizzaBase ;
         <http://purl.obolibrary.org/obo/IAO_0000115> "Relates a pizza to the base it is built on."@en ;
         rdfs:label "has base"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#hasTopping
:hasTopping rdf:type owl:ObjectProperty ;
            rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent> ;
            rdfs:domain :Pizza ;
            rdfs:range :PizzaTopping ;
            <http://purl.obolibrary.org/obo/IAO_0000115> "Relates a pizza to a topping on it."@en ;
            rdfs:label "has topping"@en .


#################################################################
#    Data properties
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasValue
<http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasValue> rdf:type owl:DatatypeProperty ;
                                                                  rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price> ;
                                                                  rdfs:range xsd:float ;
                                                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/price.owl> ;
                                                                  rdfs:label "has value"@en .


#################################################################
#    Classes
#################################################################

###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept
<http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept> rdf:type owl:Class ;
                                                                          rdfs:label "Concept" .


###  http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity
<http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Entity> rdf:type owl:Class ;
                                                                         rdfs:label "Entity" .


###  http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object
<http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object> rdf:type owl:Class ;
                                                                     rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#hasComponent> ;
                                                                                       owl:allValuesFrom <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object>
                                                                                     ] ,
                                                                                     [ rdf:type owl:Restriction ;
                                                                                       owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#isComponentOf> ;
                                                                                       owl:allValuesFrom <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object>
                                                                                     ] ;
                                                                     rdfs:comment "Any physical, social, or mental object, or a substance" ;
                                                                     rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/componency.owl> ;
                                                                     rdfs:label "Object"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/price.owl#Currency
<http://www.ontologydesignpatterns.org/cp/owl/price.owl#Currency> rdf:type owl:Class ;
                                                                  owl:disjointWith <http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price> ;
                                                                  rdfs:comment "A system of money in general use in a particular country." ;
                                                                  rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/price.owl> ;
                                                                  rdfs:label "Currency"@en .


###  http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price
<http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price> rdf:type owl:Class ;
                                                               rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasCurrency> ;
                                                                                 owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/price.owl#hasValue> ;
                                                                                 owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                               ] ;
                                                               rdfs:comment "The amount of money expected, required, or given in payment for something." ;
                                                               rdfs:isDefinedBy <http://www.ontologydesignpatterns.org/cp/owl/price.owl> ;
                                                               rdfs:label "Price"@en .


###  http://www.w3.org/2002/07/owl#Thing
owl:Thing rdf:type owl:Class .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheeseTopping
:CheeseTopping rdf:type owl:Class ;
               rdfs:subClassOf :PizzaTopping ;
               <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping made of cheese."@en ;
               rdfs:label "cheese topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#CheesyPizza
:CheesyPizza rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :hasTopping ;
                                                          owl:someValuesFrom :CheeseTopping
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :Pizza ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "Any pizza that has at least one cheese topping."@en ;
             rdfs:label "cheesy pizza"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#ChiliPepperTopping
:ChiliPepperTopping rdf:type owl:Class ;
                    rdfs:subClassOf :SpicyTopping ,
                                    :VegetableTopping ;
                    <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of chili pepper."@en ;
                    rdfs:label "chili pepper topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#DeepPanBase
:DeepPanBase rdf:type owl:Class ;
             rdfs:subClassOf :PizzaBase ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "A thick pizza base baked in a pan."@en ;
             rdfs:label "deep pan base"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Diavola
:Diavola rdf:type owl:Class ;
         rdfs:subClassOf :CheesyPizza ,
                         :NamedPizza ,
                         :SpicyPizza ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasTopping ;
                           owl:someValuesFrom :MozzarellaTopping
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasTopping ;
                           owl:someValuesFrom :SpicySalamiTopping
                         ] ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty :hasTopping ;
                           owl:someValuesFrom :TomatoTopping
                         ] ;
         <http://purl.obolibrary.org/obo/IAO_0000115> "A named pizza topped with mozzarella, tomato, spicysalami."@en ;
         rdfs:label "diavola"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#DietCategory
:DietCategory rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept> ;
              <http://purl.obolibrary.org/obo/IAO_0000115> "A concept a menu uses to say which diets a pizza suits."@en ;
              rdfs:label "diet category"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#FontinaTopping
:FontinaTopping rdf:type owl:Class ;
                rdfs:subClassOf :CheeseTopping ;
                <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of fontina."@en ;
                rdfs:label "fontina topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#FruitTopping
:FruitTopping rdf:type owl:Class ;
              rdfs:subClassOf :PizzaTopping ;
              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping made of fruit."@en ;
              rdfs:label "fruit topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Funghi
:Funghi rdf:type owl:Class ;
        rdfs:subClassOf :CheesyPizza ,
                        :NamedPizza ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasTopping ;
                          owl:someValuesFrom :MozzarellaTopping
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasTopping ;
                          owl:someValuesFrom :MushroomTopping
                        ] ,
                        [ rdf:type owl:Restriction ;
                          owl:onProperty :hasTopping ;
                          owl:someValuesFrom :TomatoTopping
                        ] ;
        <http://purl.obolibrary.org/obo/IAO_0000115> "A named pizza topped with mozzarella, tomato, mushroom."@en ;
        rdfs:label "funghi"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#GorgonzolaTopping
:GorgonzolaTopping rdf:type owl:Class ;
                   rdfs:subClassOf :CheeseTopping ;
                   <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of gorgonzola."@en ;
                   rdfs:label "gorgonzola topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#HamTopping
:HamTopping rdf:type owl:Class ;
            rdfs:subClassOf :MeatTopping ;
            <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of ham."@en ;
            rdfs:label "ham topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Hawaiian
:Hawaiian rdf:type owl:Class ;
          rdfs:subClassOf :CheesyPizza ,
                          :NamedPizza ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasTopping ;
                            owl:someValuesFrom :HamTopping
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasTopping ;
                            owl:someValuesFrom :MozzarellaTopping
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasTopping ;
                            owl:someValuesFrom :PineappleTopping
                          ] ,
                          [ rdf:type owl:Restriction ;
                            owl:onProperty :hasTopping ;
                            owl:someValuesFrom :TomatoTopping
                          ] ;
          <http://purl.obolibrary.org/obo/IAO_0000115> "A named pizza topped with mozzarella, tomato, ham, pineapple."@en ;
          rdfs:label "hawaiian"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Margherita
:Margherita rdf:type owl:Class ;
            rdfs:subClassOf :CheesyPizza ,
                            :NamedPizza ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTopping ;
                              owl:someValuesFrom :MozzarellaTopping
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty :hasTopping ;
                              owl:someValuesFrom :TomatoTopping
                            ] ;
            <http://purl.obolibrary.org/obo/IAO_0000115> "A named pizza topped with mozzarella, tomato."@en ;
            rdfs:label "margherita"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MeatTopping
:MeatTopping rdf:type owl:Class ;
             rdfs:subClassOf :PizzaTopping ;
             <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping made of meat."@en ;
             rdfs:label "meat topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MenuPrice
:MenuPrice rdf:type owl:Class ;
           rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/price.owl#Price> ;
           <http://purl.obolibrary.org/obo/IAO_0000115> "The price a menu asks for a pizza."@en ;
           rdfs:label "menu price"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MozzarellaTopping
:MozzarellaTopping rdf:type owl:Class ;
                   rdfs:subClassOf :CheeseTopping ;
                   <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of mozzarella."@en ;
                   rdfs:label "mozzarella topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#MushroomTopping
:MushroomTopping rdf:type owl:Class ;
                 rdfs:subClassOf :VegetableTopping ;
                 <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of mushroom."@en ;
                 rdfs:label "mushroom topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#NamedPizza
:NamedPizza rdf:type owl:Class ;
            rdfs:subClassOf :Pizza ;
            <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza that appears on a menu under a name."@en ;
            rdfs:label "named pizza"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#OliveTopping
:OliveTopping rdf:type owl:Class ;
              rdfs:subClassOf :VegetableTopping ;
              <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of olive."@en ;
              rdfs:label "olive topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#ParmesanTopping
:ParmesanTopping rdf:type owl:Class ;
                 rdfs:subClassOf :CheeseTopping ;
                 <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of parmesan."@en ;
                 rdfs:label "parmesan topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PineappleTopping
:PineappleTopping rdf:type owl:Class ;
                  rdfs:subClassOf :FruitTopping ;
                  <http://purl.obolibrary.org/obo/IAO_0000115> "A pizza topping of pineapple."@en ;
                  rdfs:label "pineapple topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#Pizza
:Pizza rdf:type owl:Class ;
       rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object> ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasBase ;
                         owl:someValuesFrom :PizzaBase
                       ] ;
       <http://purl.obolibrary.org/obo/IAO_0000115> "An oven-baked flat bread with toppings."@en ;
       rdfs:label "pizza"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PizzaBase
:PizzaBase rdf:type owl:Class ;
           rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object> ;
           <http://purl.obolibrary.org/obo/IAO_0000115> "The dough a pizza is built on."@en ;
           rdfs:label "pizza base"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#PizzaTopping
:PizzaTopping rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/componency.owl#Object> ;
              <http://purl.obolibrary.org/obo/IAO_0000115> "An ingredient put on a pizza base."@en ;
              rdfs:label "pizza topping"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#QuattroFormaggi
:QuattroFormaggi rdf:type owl:Class ;
                 rdfs:subClassOf :CheesyPizza ,
                                 :NamedPizza ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:someValuesFrom :FontinaTopping
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:someValuesFrom :GorgonzolaTopping
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:someValuesFrom :MozzarellaTopping
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:someValuesFrom :ParmesanTopping
                                 ] ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty :hasTopping ;
                                   owl:someValuesFrom :TomatoTopping
                                 ] ;
                 <http://purl.obolibrary.org/obo/IAO_0000115> "A named pizza topped with mozzarella, parmesan, gorgonzola, fontina, tomato."@en ;
                 rdfs:label "quattro formaggi"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#SpicinessLevel
:SpicinessLevel rdf:type owl:Class ;
                rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/classification.owl#Concept> ;
                <http://purl.obolibrary.org/obo/IAO_0000115> "A concept a menu uses to say how hot a pizza is."@en ;
                rdfs:label "spiciness level"@en .


###  https://ebrahimnorouzi.github.io/pizza-ontology/pizza.owl#SpicyPizza
:SpicyPizza rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Pizza
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :hasTopping ;
                                                         owl:someValuesFrom :SpicyTopping
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf :Pizza ;
            <http://purl.obolibrary.org/obo/IAO_0000115> "Any pizza that has at least one spicy topping."@en ;
            rdfs:label "spicy pizza"@en .


